rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Retrieve user data from users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check role permissions
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super-admin';
    }
    
    function isLeader() {
      return isSignedIn() && (getUserData().role == 'leader' || getUserData().role == 'super-admin');
    }

    // Users / Members Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Programs / Events
    match /programs/{programId} {
      allow read: if isSignedIn();
      allow write: if isLeader();
    }

    // Discussion comments
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isLeader());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isLeader());
    }

    // Announcements Board
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isLeader();
    }

    // Payments Ledger
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.memberId == getUserData().memberId || isLeader());
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Attendance Log
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (resource.data.memberId == getUserData().memberId || isLeader());
      allow write: if isLeader();
    }

    // Event Registrations
    match /registrations/{registrationId} {
      allow read: if isSignedIn() && (resource.data.memberId == getUserData().memberId || isLeader());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.memberId == getUserData().memberId || isLeader());
      allow delete: if isSignedIn() && resource.data.memberId == getUserData().memberId;
    }

    // Chat Messages
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }
  }
}
